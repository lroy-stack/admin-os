// The MCP server as its own Worker (ADR 0016): Streamable HTTP at https://mcp.admin-os.lr0y.dev/mcp. It reaches the
// demo store by `script_name`, so deploy workers/demo-store first:
//   npm run deploy:store && npm run deploy:mcp
// For your own deployment, replace the custom domain with one of your zones, or remove `routes` and set
// `workers_dev` to true.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "admin-os-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [{ "pattern": "mcp.admin-os.lr0y.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // Writes act on the token's demo session in the store Worker. MCP_READ_ONLY is left unset: the public demo tokens
    // are read-only by default (ADR 0009, H0), and a read-only server never reaches the store.
    "DATA_STORE": "durable",
    // The `period` of MCP_LIMITER below; Retry-After reads it, so change both together.
    "MCP_RATE_LIMIT_PERIOD_S": "60"
  },
  "durable_objects": {
    "bindings": [{ "name": "DEMO_STORE", "class_name": "DemoStore", "script_name": "admin-os-demo-store" }]
  },
  // One bucket per token (per grant once OAuth lands), per Cloudflare location; period is 10 or 60 seconds.
  "ratelimits": [{ "name": "MCP_LIMITER", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } }],
  // wrangler's esbuild resolves without the `react-server` condition, where `server-only` throws.
  "alias": {
    "server-only": "../stubs/server-only.ts"
  },
  "observability": { "enabled": true }
}
