// The MCP server as its own Worker (ADR 0016): Streamable HTTP at https://mcp.admin-os.lr0y.dev/mcp. It reaches the
// demo store by `script_name`, so deploy workers/demo-store first:
//   npm run deploy:store && npm run deploy:mcp
// For your own deployment, replace the custom domain with one of your zones, or remove `routes` and set
// `workers_dev` to true.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "admin-os-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [{ "pattern": "mcp.admin-os.lr0y.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // DEMO_SESSION_SECRET (a secret, the same value as the web Worker's) verifies and signs the demo_sid cookie on the
  // consent page: npx wrangler secret put DEMO_SESSION_SECRET -c workers/mcp/wrangler.jsonc
  "vars": {
    // Writes act on the caller's demo session in the store Worker. MCP_READ_ONLY is left unset: the public demo tokens
    // are read-only by default (ADR 0009, H0) and never reach the store, and an OAuth grant writes only once its person
    // grants `write` (ADR 0016 D3).
    "DATA_STORE": "durable",
    // The consent page renews the demo cookies with the web app's scope (see the root wrangler.jsonc).
    "DEMO_COOKIE_DOMAIN": "admin-os.lr0y.dev",
    // The `period` of MCP_LIMITER, OAUTH_LIMITER and EDGE_LIMITER below; Retry-After reads it, so change them together.
    "MCP_RATE_LIMIT_PERIOD_S": "60"
  },
  "durable_objects": {
    "bindings": [{ "name": "DEMO_STORE", "class_name": "DemoStore", "script_name": "admin-os-demo-store" }]
  },
  // `workers-oauth-provider`'s clients, grants and tokens. Without an `id`, `wrangler deploy` provisions the namespace;
  // to choose it yourself, create it (`npx wrangler kv namespace create OAUTH_KV`) and add its `id` here.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // Per Cloudflare location; period is 10 or 60 seconds.
  // MCP_LIMITER: /mcp, one bucket per grant, or per token and client IP for the public demo tokens.
  // OAUTH_LIMITER: /authorize, /register and /grants, and new demo sessions, per client IP (registrations write KV).
  // EDGE_LIMITER: /token and /mcp per client IP (an IPv6 /64) before any KV read; wide, because a hosted client
  // such as claude.ai calls them for all its users from a few egress IPs.
  "ratelimits": [
    { "name": "MCP_LIMITER", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
    { "name": "OAUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "EDGE_LIMITER", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } }
  ],
  // wrangler's esbuild resolves without the `react-server` condition, where `server-only` throws.
  "alias": {
    "server-only": "../stubs/server-only.ts"
  },
  "observability": { "enabled": true }
}
