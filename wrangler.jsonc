// Cloudflare Workers deployment of the public demo through the OpenNext adapter (`npm run deploy`). For your own
// deployment, rename the worker and its self-reference, and replace the custom domain with one of your zones, or
// remove `routes` and set `workers_dev` to true to serve it on your workers.dev subdomain.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "admin-os",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    {
      "pattern": "admin-os.lr0y.dev",
      "custom_domain": true
    }
  ],
  // The demo is served on its custom domain only.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext calls the worker itself for caching and revalidation; the service name must match the worker name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "admin-os"
    }
  ],
  // The demo keeps each visitor's session in a Durable Object. DEMO_SESSION_SECRET (a secret, not a var) must be set:
  //   openssl rand -base64 32 | npx wrangler secret put DEMO_SESSION_SECRET
  "vars": {
    "DATA_STORE": "durable",
    // Shares the demo cookies with the subdomains of the custom domain (replace it with your own, or remove it).
    "DEMO_COOKIE_DOMAIN": "admin-os.lr0y.dev"
  },
  // The store lives in its own Worker (workers/demo-store), deployed first; the class is reached by script_name.
  "durable_objects": {
    "bindings": [{ "name": "DEMO_STORE", "class_name": "DemoStore", "script_name": "admin-os-demo-store" }]
  },
  "observability": {
    "enabled": true
  }
}
