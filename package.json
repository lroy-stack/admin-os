{
  "name": "admin-os",
  "version": "0.2.0",
  "private": true,
  "description": "Open-source management dashboard for small businesses: restaurants, salons, workshops. Next.js, shadcn/ui, liquid glass.",
  "author": "Leroy Loewe (https://github.com/lroy-stack)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lroy-stack/admin-os.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "dev:mcp": "wrangler dev -c workers/mcp/wrangler.jsonc --port 8789 --infer-origin-from-routes=false",
    "dev:mcp:read-only": "wrangler dev -c workers/mcp/wrangler.jsonc --port 8790 --infer-origin-from-routes=false --var MCP_TOKENS: --var MCP_READ_ONLY:true",
    "build": "next build",
    "deploy:store": "wrangler deploy -c workers/demo-store/wrangler.jsonc",
    "deploy:check": "node scripts/deploy-check.mjs",
    "deploy:mcp": "wrangler deploy -c workers/mcp/wrangler.jsonc",
    "deploy": "npm run deploy:check && opennextjs-cloudflare build && npm run deploy:store && npm run deploy:mcp && opennextjs-cloudflare deploy",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "lint": "biome lint",
    "format": "biome format --write",
    "depcruise": "depcruise src workers --config .dependency-cruiser.cjs --output-type err-long",
    "workers:types": "wrangler types workers/worker-configuration.d.ts -c workers/demo-store/wrangler.jsonc",
    "typecheck:workers": "npm run workers:types && tsc -p workers/tsconfig.json",
    "check": "biome check && npm run depcruise && npm run typecheck:workers && npm run check:bundles",
    "check:bundles": "node scripts/check-worker-bundles.mjs",
    "check:fix": "biome check --write",
    "prepare": "husky",
    "generate:presets": "ts-node -P tsconfig.scripts.json src/scripts/generate-theme-presets.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:workers": "opennextjs-cloudflare build && playwright test -c playwright.workers.config.ts",
    "test:dead-clicks": "DEAD_CLICKS=report playwright test e2e/smoke/dead-clicks.spec.ts",
    "media": "playwright test -c playwright.media.config.ts",
    "probe:consistency": "tsx scripts/probe-consistency.ts",
    "eval:mcp": "tsx scripts/eval-mcp.ts",
    "mcp:stdio": "tsx --import ./scripts/server-only-hook.mjs scripts/mcp-stdio.ts",
    "mcp:reference": "tsx --import ./scripts/server-only-hook.mjs scripts/mcp-reference.ts"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,css}": ["biome check --write --no-errors-on-unmatched"]
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@dnd-kit/abstract": "^0.5.1",
    "@dnd-kit/helpers": "^0.5.1",
    "@dnd-kit/react": "^0.5.1",
    "@fullcalendar/react": "^7.1.3",
    "@hookform/resolvers": "^5.9.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "d3-geo": "^3.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.9.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.65.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.15.3",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.5.0",
    "simple-icons": "^16.36.0",
    "sonner": "^2.0.8",
    "temporal-polyfill": "^1.0.6",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@next/env": "^16.4.3",
    "@opennextjs/cloudflare": "^1.20.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@types/topojson-client": "^3.1.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.5",
    "ts-node": "^10.9.2",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
