# admin-OS environment. Copy to .env.local and fill in; every variable is optional for the demo.

# Data adapter (ADR 0005). The kit ships "mock" only.
DATA_ADAPTER=mock
# Preset of this deployment (ADR 0004): hospitality, salon or workshop.
VERTICAL=hospitality
# Forced faults per capability, e.g. "bookings.list=bookings.not_found" (ADR 0005).
MOCK_FAULTS=
# "live" swaps the seeded business moment for real time.
MOCK_CLOCK=

# MCP over Streamable HTTP (/api/mcp, ADR 0009): "<token>:<role>" pairs, comma-separated; roles are owner, manager
# and staff; tokens are 8 to 256 characters [A-Za-z0-9-._~+/]. A request without a listed token gets a 401.
# Unset or empty with DATA_ADAPTER=mock, the public demo tokens apply:
#   demo-owner-token:owner,demo-manager-token:manager,demo-staff-token:staff
# With any other adapter, unset means no token is accepted. Set your own, secret tokens outside the demo.
MCP_TOKENS=

# MCP over stdio (npm run --silent mcp:stdio): the role of the process. Default staff.
MCP_ROLE=staff
