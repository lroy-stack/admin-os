# admin-OS environment. Copy to .env.local and fill in; every variable is optional for the demo.

# Data adapter (ADR 0005). The kit ships "mock" only.
DATA_ADAPTER=mock
# Preset of this deployment (ADR 0004): hospitality, salon or workshop.
VERTICAL=hospitality
# Forced faults per capability, e.g. "bookings.list=bookings.not_found" (ADR 0005). With DATA_STORE=durable a latency
# fault is capped at 1 s inside the store.
MOCK_FAULTS=
# "live" swaps the seeded business moment for real time.
MOCK_CLOCK=

# Where a visitor's demo session lives. Unset: in the process's memory (tests, `next dev`, `next start`). "durable": in
# a Durable Object of the workers/demo-store Worker, which survives restarts and is shared by every isolate; it needs
# the binding in wrangler.jsonc (`npm run preview`, `wrangler dev -c wrangler.jsonc -c workers/demo-store/wrangler.jsonc`,
# or `next dev` with this set) and DEMO_SESSION_SECRET.
DATA_STORE=
# Signs the demo_sid cookie, so only a session id this server issued reaches the store. At least 32 characters,
# e.g. `openssl rand -base64 32`. Required with DATA_STORE=durable (on Cloudflare: `wrangler secret put
# DEMO_SESSION_SECRET`; locally in .dev.vars). In memory, unset means a random key per process.
DEMO_SESSION_SECRET=
# Host that scopes the demo_sid (session) and demo_role cookies, so its subdomains (the MCP Worker's consent page) read
# the same visitor. A bare host name such as admin-os.lr0y.dev. Applied only to requests served on that host or one
# of its subdomains; on any other host (localhost, a workers.dev preview) the cookies stay host-only. Unset: host-only.
DEMO_COOKIE_DOMAIN=

# MCP over Streamable HTTP (the MCP Worker, workers/mcp, ADR 0016; set it there with
# npx wrangler secret put MCP_TOKENS -c workers/mcp/wrangler.jsonc): "<token>:<role>" pairs, comma-separated; roles
# are owner, manager and staff; tokens are 8 to 256 characters [A-Za-z0-9-._~+/]. A request without a listed token
# gets a 401.
# Unset or empty with DATA_ADAPTER=mock, the public demo tokens apply:
#   demo-owner-token:owner,demo-manager-token:manager,demo-staff-token:staff
# With any other adapter, unset means no token is accepted. Set your own, secret tokens outside the demo.
MCP_TOKENS=

# MCP read-only mode: true lists and runs read tools only, false allows writes. Unset: read-only exactly while the
# public demo tokens above are in force over HTTP; stdio writes unless this is true.
MCP_READ_ONLY=

# MCP over stdio (npm run --silent mcp:stdio): the role of the process. Default staff.
MCP_ROLE=staff
