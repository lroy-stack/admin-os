language js(typescript, jsx)

// Finished screens carry no visible text in their markup (spec 001, AC2). `style/noJsxLiterals` covers JSX text;
// `no-visible-string-children.grit` covers strings in braces between tags; this plugin covers strings in the props
// that screen readers or eyes read: `prop="…"`, `prop={"…"}`, ``prop={`…`}`` and `prop={cond ? "…" : "…"}`. The list
// is by prop name because Biome's `noStrings` option cannot tell `aria-label` from `className`.
// A plain string with no letters ("%", "·", "—") is punctuation, not text, and stays allowed.
// See docs/adr/0007-i18n-typed-dictionaries.md ("How to translate a screen").
JsxAttribute(name=$name, initializer=JsxAttributeInitializerClause(value=$value)) as $attribute where {
  $name <: r"^(?:aria-label|aria-description|aria-placeholder|aria-roledescription|aria-valuetext|placeholder|title|alt|label|description|tooltip|helperText|emptyText|emptyLabel|heading|caption|summary|message|[a-zA-Z]*Label|[a-zA-Z]*Text|[a-zA-Z]*Title|[a-zA-Z]*Description|[a-zA-Z]*Placeholder|[a-zA-Z]*Message)$",
  $value <: or {
    and { JsxString(),
    r".*\p{L}.*" },
    JsxExpressionAttributeValue(expression=or {
      and { JsStringLiteralExpression(),
      r".*\p{L}.*" },
      JsTemplateExpression(),
      JsConditionalExpression(consequent=and { JsStringLiteralExpression(),
      r".*\p{L}.*" }),
      JsConditionalExpression(alternate=and { JsStringLiteralExpression(),
      r".*\p{L}.*" })
    })
  },
  register_diagnostic(span=$attribute, message="Visible text belongs in the route's dictionary (docs/adr/0007-i18n-typed-dictionaries.md), not in this prop.", severity="error")
}
